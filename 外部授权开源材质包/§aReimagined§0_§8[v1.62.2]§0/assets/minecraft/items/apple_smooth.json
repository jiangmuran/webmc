{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/apple"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "remaining": true,
        "scale": 0.045,
        "entries": [
          {
            "threshold": 1,
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/apple"
            }
          },
		  {
            "threshold": 0.92,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat1"}
          },
		  {
            "threshold": 0.83,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat2"}
          },
		  {
            "threshold": 0.75,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat3"}
          },
		  {
            "threshold": 0.67,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat4"}
          },
		  {
            "threshold": 0.58,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat5"}
          },
		  {
            "threshold": 0.50,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat6"}
          },
		  {
            "threshold": 0.42,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat7"}
          },
		  {
            "threshold": 0.33,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat8"}
          },
		  {
            "threshold": 0.25,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat9"}
          },
		  {
            "threshold": 0.17,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat10"}
          },
		  {
            "threshold": 0.08,"model": {"type": "minecraft:model","model": "minecraft:item/eating_vanilla/apple_eat11"}
          },
		  
		  
		  {
            "threshold": 0.05,
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/eating_vanilla/empty"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "minecraft:item/eating_vanilla/empty"
        }
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/apple"
      }
    }
  }
}