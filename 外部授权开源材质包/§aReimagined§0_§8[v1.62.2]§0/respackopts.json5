{
    id: "reimagined",
    version: 13,
    capabilities: ["FileFilter", "DirFilter"],
    conf: {
            armorIconStyle: ["chestplate", "shield"],
			halfHeartStyle: ["reimaginedStyle", "classicStyle"],
			
			reimaginedHotbar: true,
			reimaginedXpBar: true,
			
		blockSettings: {
			extraPlankVariants: ["disabled", "enabled"],
			extraCobblestoneVariants: ["disabled", "enabled"],
			fleshierNetherrack: ["disabled", "enabled"],
			bushyLeaves: ["disabled", "enabled"]
			
		},

		modCompatibility: {
			holdMyItems: false,
			
			continuity: {
			connectedPlankBorders: ["enabled", "disabled"]
			}
		},
			
		experimental: {
		  requiresFabricApiOrAShaderToWork: {
			grassStyle: ["flat", "grassy"]
			}
		}
    }
}